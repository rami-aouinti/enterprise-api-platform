<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         cacheDirectory="var/phpunit"
         colors="true"
         failOnRisky="true"
         failOnWarning="true">
    <php>
        <server name="APP_ENV" value="test" force="true"/>
        <server name="APP_DEBUG" value="1"/>
        <server name="APP_SECRET" value="test-secret-not-for-production"/>
        <server name="KERNEL_CLASS" value="App\Kernel"/>
        <server name="DB_HOST" value="127.0.0.1"/>
        <server name="DB_PORT" value="5432"/>
        <server name="DB_NAME" value="enterprise_api_test"/>
        <server name="DB_USER" value="enterprise_api"/>
        <server name="DB_PASSWORD" value="test-password"/>
    </php>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Functional">
            <directory>tests/Functional</directory>
        </testsuite>
    </testsuites>
</phpunit>
