{
  "name": "rami-aouinti/enterprise-api-platform",
  "type": "project",
  "license": "MIT",
  "description": "Enterprise API integration platform - Symfony customer service",
  "require": {
    "php": ">=8.4",
    "ext-ctype": "*",
    "ext-iconv": "*",
    "ext-pdo": "*",
    "ext-pdo_pgsql": "*",
    "doctrine/dbal": "^4.2",
    "doctrine/doctrine-bundle": "^2.13",
    "symfony/cache": "^7.4",
    "symfony/console": "^7.4",
    "symfony/dotenv": "^7.4",
    "symfony/flex": "^2.6",
    "symfony/framework-bundle": "^7.4",
    "symfony/http-client": "^8.1",
    "symfony/runtime": "^7.4",
    "symfony/security-bundle": "^8.0",
    "symfony/yaml": "^7.4",
    "web-token/jwt-library": "^4.2"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.80",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^11.5",
    "symfony/browser-kit": "^7.4",
    "symfony/css-selector": "^7.4"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "APP_ENV=test phpunit",
    "test:unit": "phpunit --testsuite Unit",
    "test:functional": "phpunit --testsuite Functional",
    "analyse": "phpstan analyse --configuration=phpstan.neon",
    "cs:check": "php-cs-fixer fix --dry-run --diff",
    "cs:fix": "php-cs-fixer fix",
    "quality": [
      "@cs:check",
      "@analyse",
      "@test"
    ],
    "auto-scripts": {
      "cache:clear": "symfony-cmd",
      "assets:install %PUBLIC_DIR%": "symfony-cmd"
    }
  },
  "config": {
    "allow-plugins": {
      "symfony/flex": true,
      "symfony/runtime": true
    },
    "sort-packages": true,
    "optimize-autoloader": true,
    "preferred-install": {
      "*": "dist"
    }
  },
  "extra": {
    "symfony": {
      "allow-contrib": false,
      "require": "7.4.*"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
