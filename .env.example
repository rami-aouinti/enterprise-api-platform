APP_ENV=dev
APP_DEBUG=1
APP_SECRET=replace-with-a-long-random-local-secret
DEFAULT_URI=http://localhost:8000

POSTGRES_DB=enterprise_api
POSTGRES_USER=enterprise_api
POSTGRES_PASSWORD=change-this-local-password

RABBITMQ_DEFAULT_USER=enterprise_api
RABBITMQ_DEFAULT_PASS=change-this-local-rabbitmq-password
RABBITMQ_DEFAULT_VHOST=/

KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=change-this-keycloak-admin-password
KEYCLOAK_MACHINE_CLIENT_SECRET=replace-with-a-long-random-machine-client-secret
KEYCLOAK_PUBLIC_URL=http://localhost:8081
KEYCLOAK_ISSUER=http://localhost:8081/realms/enterprise-platform
KEYCLOAK_DISCOVERY_BASE_URI=http://keycloak:8080/realms/enterprise-platform/
KEYCLOAK_AUDIENCE=enterprise-api
